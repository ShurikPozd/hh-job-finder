BOT_TOKEN=your_telegram_bot_token
OWNER_ID=413174367

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
# Модель для парсинга длинных резюме (большой лимит TPM). Пусто = GROQ_MODEL.
GROQ_PARSE_MODEL=groq/compound-mini

# hh.ru
HH_AREA=1
HH_EXPERIENCE=noExperience,between1And3
HH_SCHEDULE=fullDay,remote
HH_PERIOD=14
HH_DEFAULT_KEYWORDS=python developer,junior python,qa automation,junior qa,fullstack python
HH_MIN_SALARY=0

# Логика уведомлений
DEFAULT_MATCH_THRESHOLD=6
DEFAULT_SEARCH_INTERVAL_HOURS=3

# Реестр Минцифры (кэшируется локально)
# REGISTRY_URL=https://api.crftr.net/open/rawapi/v3/minsvyaz/accreditorgs

# Health check (Render задаёт PORT; локально — фиксированный порт)
HTTP_PORT=8081

# Прокси для локального запуска из РФ (на Render оставьте пустыми)
# TG_PROXY=socks5://127.0.0.1:10808
# GROQ_PROXY=socks5://127.0.0.1:10808

# Облачный бэкап БД в GitHub (спасает при эфемерном диске Render free)
# GITHUB_TOKEN=ghp_your_token
GITHUB_REPO=ShurikPozd/hh-job-finder-backups
GITHUB_BRANCH=main
GITHUB_PATH=backups
BACKUP_INTERVAL_HOURS=4