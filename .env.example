BOT_TOKEN=your_telegram_bot_token
OWNER_ID=413174367

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
# Парсинг резюме (длинный вход, операция редкая): держим на compound-mini,
# чтобы не тратить суточный пул qwen. Пусто = GROQ_MODEL.
GROQ_PARSE_MODEL=groq/compound-mini
# Скоринг вакансий — главный потребитель квоты.
GROQ_SCORE_MODEL=qwen/qwen3.8-27b

# Лимиты free-тира Groq (на организацию, ключи НЕ изолированы!):
#   qwen/qwen3.8-27b              — 8000 TPM, 1000 OTPM, 1000 запросов/день, 200k токенов/день
#   groq/compound-mini            — 250 запросов/день, 70k TPM; внутри работает
#                                   llama-3.3-70b-versatile с лимитом 100k токенов/день
# OTPM-лимитер резервирует запрошенный max_tokens — поэтому он маленький.
GROQ_SCORE_MAX_TOKENS=400
GROQ_LETTER_MAX_TOKENS=800
GROQ_BANK_MAX_TOKENS=2500

# Бюджет скоринга (в токенах). Общий пул qwen делят также tg-saver и
# расширение yt-comment-summary, поэтому берём только часть.
SCORE_EST_TOKENS=1500
SCORE_TOKEN_BUDGET_PER_RUN=6000
SCORE_TOKEN_BUDGET_PER_DAY=60000

# hh.ru
HH_AREA=1
HH_EXPERIENCE=noExperience,between1And3
HH_SCHEDULE=fullDay,remote
HH_PERIOD=14
HH_DEFAULT_KEYWORDS=python developer,junior python,qa automation,junior qa,fullstack python
HH_MIN_SALARY=0

# Логика уведомлений
DEFAULT_MATCH_THRESHOLD=6
DEFAULT_SEARCH_INTERVAL_HOURS=3

# Реестр Минцифры (кэшируется локально)
# REGISTRY_URL=https://api.crftr.net/open/rawapi/v3/minsvyaz/accreditorgs

# Health check (Render задаёт PORT; локально — фиксированный порт)
HTTP_PORT=8081

# Прокси для локального запуска из РФ (на Render оставьте пустыми)
# TG_PROXY=socks5://127.0.0.1:10808
# GROQ_PROXY=socks5://127.0.0.1:10808

# Облачный бэкап БД в GitHub (спасает при эфемерном диске Render free)
# GITHUB_TOKEN=ghp_your_token
GITHUB_REPO=ShurikPozd/hh-job-finder-backups
GITHUB_BRANCH=main
GITHUB_PATH=backups
BACKUP_INTERVAL_HOURS=4